#version 460
#pragma unroll
#pragma optionNV(unroll all)
#extension GL_ARB_shading_language_include : enable
#extension GL_NV_gpu_shader5 : enable
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

// Builds the draw lists for Iris's shadow pass (see command_buffer_builder.comp for the normal pass).
// Bound with shadow-specific SceneData, so regionIndicies, sectionVisibility, sectionIndices and the command buffers
// are the shadow pass's own. sectionVisibility holds 1 for each section in Sodium's shadow render list (built from
// Iris's shadow frustum on the CPU), instead of the occlusion results of the player's view.

#import <nvidium:occlusion/scene.glsl>

layout(local_size_x = 32) in;

bool hasOpaqueData(ivec4 header) {
    return !sectionEmpty(header) && (header.y & (1 << 17)) == 0;
}

// Same mapping as command_buffer_builder.comp: a section's translucent data can live in another slot of the region
uint getReflectedTranslucentSectionId(uint sectionId) {
    ivec4 header = sectionData[sectionId].header;
    if (!sectionEmpty(header)) {
        sectionId &= ~0xFFu;
        sectionId |= uint((header.y>>18)&0xFFu);
    }
    return sectionId;
}

bool hasTranslucentData(uint sectionId) {
    return sectionData[sectionId].tranlucentQuadCount > 0;
}

void main() {
    uint baseSectionId = uint(regionIndicies[gl_WorkGroupID.x]) << 8;

    uvec2 renderCounts = uvec2(0);
    for (uint i = 0; i < 8; i++) {
        uint sectionId = baseSectionId + gl_LocalInvocationID.x * 8 + i;
        if (sectionVisibility[sectionId] == uint8_t(0)) {
            continue;
        }
        uint translucentId = getReflectedTranslucentSectionId(sectionId);
        renderCounts += uvec2(uint(hasOpaqueData(sectionData[sectionId].header)), uint(hasTranslucentData(translucentId)));
    }

    uvec2 workId = subgroupExclusiveAdd(renderCounts);
    uvec2 totalSectionCount = subgroupAdd(renderCounts);

    for (uint i = 0; i < 8; i++) {
        uint sectionId = baseSectionId + gl_LocalInvocationID.x * 8 + i;
        if (sectionVisibility[sectionId] == uint8_t(0)) {
            continue;
        }
        if (hasOpaqueData(sectionData[sectionId].header)) {
            sectionIndices[baseSectionId + workId.x++].x = uint8_t(sectionId & 0xFF);
        }
        uint translucentId = getReflectedTranslucentSectionId(sectionId);
        if (hasTranslucentData(translucentId)) {
            sectionIndices[baseSectionId + workId.y++].y = uint8_t(translucentId & 0xFF);
        }
    }

    if (subgroupElect()) {
        terrainCommandBuffer[gl_WorkGroupID.x] = uvec2(totalSectionCount.x, baseSectionId);
        translucencyCommandBuffer[gl_WorkGroupID.x] = uvec2(totalSectionCount.y, baseSectionId);
    }
}
